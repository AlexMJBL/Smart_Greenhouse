@model Greenhouse_Ressource_MVC.Dtos.PlantDto

@{
    ViewData["Title"] = "Delete Plant";
}

<div class="container mt-4">

    <h2 class="text-danger mb-3">⚠️ Delete Plant</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this plant?
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="card-title mb-3">Plant information</h5>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Specimen</dt>
                <dd class="col-sm-9">@Model.SpecimenId</dd>

                <dt class="col-sm-3">Zone</dt>
                <dd class="col-sm-9">@Model.ZoneId</dd>

                <dt class="col-sm-3">Mom Plant</dt>
                <dd class="col-sm-9">@Model.MomId</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.IsActive ? "Yes" : "No")
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

            </dl>

            <form asp-action="DeleteConfirmed" class="mt-4">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Cancel
                    </a>

                    <button type="submit" class="btn btn-danger">
                        🗑 Delete
                    </button>

                </div>

            </form>

        </div>
    </div>
</div>