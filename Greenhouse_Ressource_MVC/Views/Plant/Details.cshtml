@model Greenhouse_Ressource_MVC.ViewModel.PlantDetailViewModel

@{
    ViewData["Title"] = "Plant details";
}

<div class="container mt-4">

    <h2 class="mb-4">🌱 Plant details</h2>

    <div class="row g-4">

        <!-- PLANT -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    Plant
                </div>
                <div class="card-body">

                    <p><strong>Id:</strong> @Model.Plant.Id</p>
                    <p><strong>Description:</strong> @Model.Plant.Description</p>

                    <p>
                        <strong>Status:</strong>
                        <span class="badge @(Model.Plant.IsActive ? "bg-success" : "bg-secondary")">
                            @(Model.Plant.IsActive ? "Active" : "Inactive")
                        </span>
                    </p>

                    <p><strong>Created:</strong> @Model.Plant.CreatedAt</p>

                </div>
            </div>
        </div>

        <!-- SPECIMEN -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-info text-white">
                    Specimen
                </div>
                <div class="card-body">

                    <p><strong>Id:</strong> @Model.Specimen.Id</p>
                    <p><strong>Name:</strong> @Model.Specimen.Name</p>
                    <p><strong>Created:</strong> @Model.Specimen.CreatedAt</p>

                </div>
            </div>
        </div>

        <!-- ZONE -->
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-warning">
                    Zone
                </div>
                <div class="card-body">

                    <p><strong>Id:</strong> @Model.Zone.Id</p>
                    <p><strong>Description:</strong> @Model.Zone.Description</p>
                    <p><strong>Created:</strong> @Model.Zone.CreatedAt</p>

                </div>
            </div>
        </div>

        <!-- MOM PLANT -->
        @if (Model.MomPlant != null)
        {
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-secondary text-white">
                        🌿 Mother plant
                    </div>
                    <div class="card-body">

                        <p><strong>Id:</strong> @Model.MomPlant.Id</p>
                        <p><strong>Description:</strong> @Model.MomPlant.Description</p>

                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(Model.MomPlant.IsActive ? "bg-success" : "bg-secondary")">
                                @(Model.MomPlant.IsActive ? "Active" : "Inactive")
                            </span>
                        </p>

                    </div>
                </div>
            </div>
        }

    </div>

    <div class="mt-4 d-flex justify-content-between">

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to list
        </a>

        <a asp-action="Edit" asp-route-id="@Model.Plant.Id" class="btn btn-primary">
            ✏️ Edit
        </a>

    </div>

</div>