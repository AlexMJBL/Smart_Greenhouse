@model Greenhouse_Ressource_MVC.Dtos.ZoneCategoryDto

@{
    ViewData["Title"] = "Zone Category Details";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">🌱 Zone Category Details</h2>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary me-2">
                ✏ Edit
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                ⬅ Back to list
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Humidity range</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @Model.HumidityMinPct % → @Model.HumidityMaxPct %
                    </span>
                </dd>

                <dt class="col-sm-3">Luminosity range</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">
                        @Model.LuminosityMinLux → @Model.LuminosityMaxLux lux
                    </span>
                </dd>

                <dt class="col-sm-3">Temperature range</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-danger">
                        @Model.TemperatureMinC °C → @Model.TemperatureMaxC °C
                    </span>
                </dd>

                <dt class="col-sm-3">Pressure range</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">
                        @Model.PressureMinPa → @Model.PressureMaxPa Pa
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

            </dl>

        </div>
    </div>

</div>