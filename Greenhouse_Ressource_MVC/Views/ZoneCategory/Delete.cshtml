@model Greenhouse_Ressource_MVC.Dtos.ZoneCategoryDto

@{
    ViewData["Title"] = "Delete Zone Category";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0 text-danger">🗑 Delete Zone Category</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to list
        </a>
    </div>

    <div class="card shadow-sm border-danger">
        <div class="card-body">

            <h5 class="text-danger mb-3">
                Are you sure you want to delete this?
            </h5>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Humidity range</dt>
                <dd class="col-sm-9">
                    @Model.HumidityMinPct % → @Model.HumidityMaxPct %
                </dd>

                <dt class="col-sm-3">Luminosity range</dt>
                <dd class="col-sm-9">
                    @Model.LuminosityMinLux → @Model.LuminosityMaxLux lux
                </dd>

                <dt class="col-sm-3">Temperature range</dt>
                <dd class="col-sm-9">
                    @Model.TemperatureMinC °C → @Model.TemperatureMaxC °C
                </dd>

                <dt class="col-sm-3">Pressure range</dt>
                <dd class="col-sm-9">
                    @Model.PressureMinPa → @Model.PressureMaxPa Pa
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

            </dl>

            <!-- 🔹 ACTIONS -->
            <form asp-action="DeleteConfirmed" class="d-flex justify-content-end mt-4">

                <a asp-action="Index" class="btn btn-outline-secondary me-2">
                    Cancel
                </a>

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    🗑 Delete
                </button>

            </form>

        </div>
    </div>

</div>