@model Greenhouse_Ressource_MVC.ViewModel.SensorDetailViewModel

@{
    ViewData["Title"] = "Sensor details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📡 Sensor details</h2>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Sensor.Id" class="btn btn-warning">
                ✏️ Edit
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                ⬅ Back
            </a>
        </div>
    </div>

    <div class="row">

        <!-- SENSOR CARD -->
        <div class="col-md-6">

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-primary text-white">
                    Sensor
                </div>

                <div class="card-body">

                    <h5 class="card-title">
                        @Model.Sensor.SensorCode
                    </h5>

                    <p class="text-muted">
                        @Model.Sensor.Description
                    </p>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">
                            @switch (Model.Sensor.Type.ToString())
                            {
                                case "temperature":
                                    <span>🌡️ Temperature</span>
                                    break;
                                case "humidity":
                                    <span>💧 Humidity</span>
                                    break;
                                case "light":
                                    <span>☀️ Light</span>
                                    break;
                                case "pressure":
                                    <span>🌬️ Pressure</span>
                                    break;
                                default:
                                    @Model.Sensor.Type
                                    break;
                            }
                        </dd>

                        <dt class="col-sm-4">Connectivity</dt>
                        <dd class="col-sm-8">
                            @if (Model.Sensor.LastSeen)
                            {
                                <span class="badge bg-success">🟢 Online</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">🔴 Offline</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            @Model.Sensor.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            @if (Model.Sensor.IsActive)
                            {
                                <span class="badge bg-success">🟢 Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">⚫ Inactive</span>
                            }
                        </dd>

                    </dl>

                </div>
            </div>

        </div>

        <!-- ZONE CARD -->
        <div class="col-md-6">

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-success text-white">
                    Zone
                </div>

                <div class="card-body">

                    <h5 class="card-title">
                        Zone #@Model.Zone.Id
                    </h5>

                    <p class="text-muted">
                        @Model.Zone.Description
                    </p>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            @Model.Zone.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

    </div>

</div>