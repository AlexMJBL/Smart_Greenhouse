@model Greenhouse_Ressource_MVC.Dtos.SensorWriteDto

@{
    ViewData["Title"] = "Create Sensor";
}

<div class="container mt-4">

    <h2 class="mb-3">🌡️ Add a new sensor</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Sensor code -->
                <div class="mb-3">
                    <label asp-for="SensorCode" class="form-label"></label>
                    <input asp-for="SensorCode" class="form-control" />
                    <span asp-validation-for="SensorCode" class="text-danger"></span>
                </div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Type -->
                <div class="mb-3">
                    <label asp-for="Type" class="form-label"></label>
                    <select asp-for="Type"
                            asp-items="ViewBag.SensorTypes"
                            class="form-select">
                        <option value="">-- Select a sensor type --</option>
                    </select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <!-- Zone -->
                <div class="mb-3">
                    <label asp-for="ZoneId" class="form-label"></label>
                    <select asp-for="ZoneId"
                            asp-items="ViewBag.ZoneCategories"
                            class="form-select">
                        <option value="">-- Select a zone --</option>
                    </select>
                    <span asp-validation-for="ZoneId" class="text-danger"></span>
                </div>

                <!-- Status -->
                <div class="mb-4">
                    <label asp-for="IsActive" class="form-label"></label>
                    <select asp-for="IsActive" class="form-select">
                        <option value="true">🟢 Active</option>
                        <option value="false">⚫ Inactive</option>
                    </select>
                    <span asp-validation-for="IsActive" class="text-danger"></span>
                </div>

                <!-- Buttons -->
                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back
                    </a>

                    <button type="submit" class="btn btn-success">
                        💾 Create sensor
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}