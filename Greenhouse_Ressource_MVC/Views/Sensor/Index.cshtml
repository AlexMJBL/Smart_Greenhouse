@model IEnumerable<Greenhouse_Ressource_MVC.Dtos.SensorDto>

@{
    ViewData["Title"] = "Sensors";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">📡 Sensors</h2>

        <a asp-action="Create" class="btn btn-success shadow-sm">
            ➕ Create new sensor
        </a>
    </div>

    <!-- 🔹 CARD -->
    <div class="card shadow-sm">
        <div class="card-body table-responsive p-0">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                    <tr>
                        <th style="width:70px;">Id</th>
                        <th>Code</th>
                        <th>Description</th>
                        <th>Type</th>
                        <th>Zone</th>
                        <th>Last seen</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="text-end" style="width:150px;">Actions</th>
                    </tr>
                </thead>

                <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center p-4 text-muted">
                            No sensors found 🌱
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>

                            <td class="fw-semibold">@item.SensorCode</td>

                            <td>@item.Description</td>

                            <td>
                                <span class="badge bg-info text-dark">
                                    @item.Type
                                </span>
                            </td>

                            <td>
                                <span class="badge bg-secondary">
                                    @item.ZoneId
                                </span>
                            </td>

                            <td>
                                <span class="badge @(item.LastSeen ? "bg-success" : "bg-secondary")">
                                    @(item.LastSeen ? "🟢 Online" : "⚫ Offline")
                                </span>
                            </td>

                            <td>
                                <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>

                            <td>
                                @item.CreatedAt.ToString("yyyy-MM-dd")
                            </td>

                            <td class="text-end">

                                <div class="btn-group btn-group-sm">

                                    <a asp-action="Edit" asp-route-id="@item.Id"
                                       class="btn btn-outline-primary">
                                        ✏️
                                    </a>

                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-outline-info">
                                        🔍
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger">
                                        🗑️
                                    </a>

                                </div>

                            </td>
                        </tr>
                    }
                }

                </tbody>

            </table>

        </div>
    </div>

</div>