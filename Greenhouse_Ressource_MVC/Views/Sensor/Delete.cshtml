@model Greenhouse_Ressource_MVC.Dtos.SensorDto

@{
    ViewData["Title"] = "Delete sensor";
}

<div class="container mt-4">

    <div class="card border-danger shadow-sm">

        <div class="card-header bg-danger text-white">
            ⚠️ Confirm sensor deletion
        </div>

        <div class="card-body">

            <h5 class="mb-3">
                Are you sure you want to delete this sensor?
            </h5>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9">@Model.SensorCode</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">

                    @switch (Model.Type.ToString())
                    {
                        case "temperature":
                            <span>🌡️ Temperature</span>
                            break;
                        case "humidity":
                            <span>💧 Humidity</span>
                            break;
                        case "light":
                            <span>☀️ Light</span>
                            break;
                        case "pressure":
                            <span>🌬️ Pressure</span>
                            break;
                        default:
                            @Model.Type
                            break;
                    }

                </dd>

                <dt class="col-sm-3">Zone</dt>
                <dd class="col-sm-9">@Model.ZoneId</dd>

                <dt class="col-sm-3">Connection</dt>
                <dd class="col-sm-9">
                    @if (Model.LastSeen)
                    {
                        <span class="badge bg-success">🟢 Online</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">⚫ Offline</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">🟢 Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">⚫ Inactive</span>
                    }
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed" class="mt-4">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back
                    </a>

                    <button type="submit" class="btn btn-danger">
                        🗑️ Delete
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>