@model Greenhouse_Ressource_MVC.Dtos.SoilHumidityCategoryDto

@{
    ViewData["Title"] = "Soil humidity category details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>💧 Soil humidity category</h2>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-warning shadow-sm">
                ✏️ Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                ⬅ Back
            </a>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            Category information
        </div>

        <div class="card-body">

            <h5 class="card-title fw-bold">
                @Model.Name
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Min humidity</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-info text-dark">
                        @Model.MinHumidityPct %
                    </span>
                </dd>

                <dt class="col-sm-4">Max humidity</dt>
                <dd class="col-sm-8">
                    <span class="badge bg-primary">
                        @Model.MaxHumidityPct %
                    </span>
                </dd>

                <dt class="col-sm-4">Created</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

    </div>

</div>