@model Greenhouse_Ressource_MVC.Dtos.SoilHumidityCategoryDto

@{
    ViewData["Title"] = "Delete soil humidity category";
}

<div class="container mt-4">

    <div class="card border-danger shadow-sm">

        <div class="card-header bg-danger text-white">
            ⚠️ Confirm deletion
        </div>

        <div class="card-body">

            <h5 class="mb-3">
                Are you sure you want to delete this category?
            </h5>

            <dl class="row">

                <dt class="col-sm-4">Id</dt>
                <dd class="col-sm-8">@Model.Id</dd>

                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Min humidity</dt>
                <dd class="col-sm-8">@Model.MinHumidityPct %</dd>

                <dt class="col-sm-4">Max humidity</dt>
                <dd class="col-sm-8">@Model.MaxHumidityPct %</dd>

                <dt class="col-sm-4">Created</dt>
                <dd class="col-sm-8">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed" class="mt-4">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back
                    </a>

                    <button type="submit" class="btn btn-danger">
                        🗑️ Delete
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>