@model Greenhouse_Ressource_MVC.Dtos.SoilHumidityCategoryWriteDto

@{
    ViewData["Title"] = "Create soil humidity category";
}

<div class="container mt-4">

    <h2 class="text-success mb-4">💧 New soil humidity category</h2>

    <div class="card shadow-sm border-success">

        <div class="card-header bg-success text-white fw-semibold">
            Category information
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- NAME -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- MIN -->
                <div class="mb-3">
                    <label asp-for="MinHumidityPct" class="form-label fw-semibold"></label>
                    <input asp-for="MinHumidityPct" class="form-control" />
                    <span asp-validation-for="MinHumidityPct" class="text-danger"></span>
                </div>

                <!-- MAX -->
                <div class="mb-3">
                    <label asp-for="MaxHumidityPct" class="form-label fw-semibold"></label>
                    <input asp-for="MaxHumidityPct" class="form-control" />
                    <span asp-validation-for="MaxHumidityPct" class="text-danger"></span>
                </div>

                <!-- BUTTONS -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-success">
                        💾 Create
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back to list
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}