@model Greenhouse_Ressource_MVC.Dtos.SoilHumidityCategoryWriteDto

@{
    ViewData["Title"] = "Edit soil humidity category";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>✏️ Edit soil humidity category</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-success text-white">
            Category information
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- NAME -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- MIN HUMIDITY -->
                <div class="mb-3">
                    <label asp-for="MinHumidityPct" class="form-label fw-semibold"></label>
                    <input asp-for="MinHumidityPct" type="number" class="form-control" />
                    <span asp-validation-for="MinHumidityPct" class="text-danger"></span>
                </div>

                <!-- MAX HUMIDITY -->
                <div class="mb-4">
                    <label asp-for="MaxHumidityPct" class="form-label fw-semibold"></label>
                    <input asp-for="MaxHumidityPct" type="number" class="form-control" />
                    <span asp-validation-for="MaxHumidityPct" class="text-danger"></span>
                </div>

                <!-- BUTTONS -->
                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-success shadow-sm">
                        💾 Save
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}