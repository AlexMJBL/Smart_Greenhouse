@model Greenhouse_Ressource_MVC.ViewModel.WateringDetailViewModel

@{
    ViewData["Title"] = "Watering Details";
}

<div class="container-page">

    <div class="page-header">
        <h1>Watering Details</h1>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>

    <!-- 🌱 WATERING -->
    <div class="form-card">

        <h4 class="section-title">Watering</h4>

        <div class="details-grid">

            <div class="details-label">Id</div>
            <div class="details-value">@Model.Watering.Id</div>

            <div class="details-label">Humidity before</div>
            <div class="details-value">@Model.Watering.HumPctBefore %</div>

            <div class="details-label">Humidity after</div>
            <div class="details-value">@Model.Watering.HumPctAfter %</div>

            <div class="details-label">Water quantity</div>
            <div class="details-value">@Model.Watering.WaterQuantityMl ml</div>

            <div class="details-label">Created</div>
            <div class="details-value">
                @Model.Watering.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </div>

        </div>

    </div>

    <!-- 🌿 PLANT -->
    <div class="form-card">

        <h4 class="section-title">Plant</h4>

        <div class="details-grid">

            <div class="details-label">Id</div>
            <div class="details-value">@Model.Plant.Id</div>

            <div class="details-label">Mom Id</div>
            <div class="details-value">@Model.Plant.MomId</div>

            <div class="details-label">Description</div>
            <div class="details-value">@Model.Plant.Description</div>

            <div class="details-label">Status</div>
            <div class="details-value">
                <span class="badge @(Model.Plant.IsActive ? "bg-success" : "bg-secondary")">
                    @(Model.Plant.IsActive ? "Active" : "Inactive")
                </span>
            </div>

            <div class="details-label">Created</div>
            <div class="details-value">
                @Model.Plant.CreatedAt.ToString("yyyy-MM-dd HH:mm")
            </div>

        </div>

    </div>

    <div class="form-actions">
        <a asp-action="Edit" asp-route-id="@Model.Watering.Id" class="btn btn-primary">
            Edit
        </a>
        <a asp-action="Index" class="btn btn-outline">
            Back to list
        </a>
    </div>

</div>