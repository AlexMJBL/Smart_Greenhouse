@model Greenhouse_Ressource_MVC.Dtos.WateringWriteDto

@{
    ViewData["Title"] = "Edit Watering";
}

<div class="container-page">

    <div class="page-header">
        <h1>Edit Watering</h1>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>

    <div class="form-card">

        <form asp-action="Edit">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="HumPctBefore"></label>
                <input asp-for="HumPctBefore" class="form-control" />
                <span asp-validation-for="HumPctBefore" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="HumPctAfter"></label>
                <input asp-for="HumPctAfter" class="form-control" />
                <span asp-validation-for="HumPctAfter" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="WaterQuantityMl"></label>
                <input asp-for="WaterQuantityMl" class="form-control" />
                <span asp-validation-for="WaterQuantityMl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PlantId"></label>
                <select asp-for="PlantId"
                        asp-items="ViewBag.Plants"
                        class="form-control">
                    <option value="">-- Select a plant --</option>
                </select>
                <span asp-validation-for="PlantId" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    Save
                </button>

                <a asp-action="Index" class="btn btn-outline">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}