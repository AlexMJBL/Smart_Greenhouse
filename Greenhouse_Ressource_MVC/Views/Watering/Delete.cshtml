@model Greenhouse_Ressource_MVC.Dtos.WateringDto

@{
    ViewData["Title"] = "Delete Watering";
}

<div class="container-page">

    <div class="page-header">
        <h1>Delete Watering</h1>
        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
    </div>

    <div class="form-card">

        <h3 class="text-danger">Are you sure you want to delete this?</h3>

        <div class="details-grid">

            <div class="details-item">
                <span class="details-label">@Html.DisplayNameFor(model => model.Id)</span>
                <span class="details-value">@Html.DisplayFor(model => model.Id)</span>
            </div>

            <div class="details-item">
                <span class="details-label">@Html.DisplayNameFor(model => model.HumPctBefore)</span>
                <span class="details-value">@Html.DisplayFor(model => model.HumPctBefore)</span>
            </div>

            <div class="details-item">
                <span class="details-label">@Html.DisplayNameFor(model => model.HumPctAfter)</span>
                <span class="details-value">@Html.DisplayFor(model => model.HumPctAfter)</span>
            </div>

            <div class="details-item">
                <span class="details-label">@Html.DisplayNameFor(model => model.WaterQuantityMl)</span>
                <span class="details-value">@Html.DisplayFor(model => model.WaterQuantityMl)</span>
            </div>

            <div class="details-item">
                <span class="details-label">@Html.DisplayNameFor(model => model.PlantId)</span>
                <span class="details-value">@Html.DisplayFor(model => model.PlantId)</span>
            </div>

            <div class="details-item">
                <span class="details-label">@Html.DisplayNameFor(model => model.CreatedAt)</span>
                <span class="details-value">@Html.DisplayFor(model => model.CreatedAt)</span>
            </div>

        </div>

        <form asp-action="DeleteConfirmed">

            <input type="hidden" asp-for="Id" />

            <div class="form-actions">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-outline">Cancel</a>
            </div>

        </form>

    </div>

</div>