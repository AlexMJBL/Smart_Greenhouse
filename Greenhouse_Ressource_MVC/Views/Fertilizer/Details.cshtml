@model Greenhouse_Ressource_MVC.ViewModel.FertilizerDetailViewModel

@{
    ViewData["Title"] = "Fertilizer Details";
}

<div class="container">

    <h2 class="mb-4 text-success">🌿 Fertilizer Details</h2>

    <div class="row g-4">

        <!-- 🌱 Fertilizer -->
        <div class="col-md-6">
            <div class="card shadow-sm border-success h-100">
                <div class="card-header bg-success text-white fw-semibold">
                    Fertilizer Info
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4">Id</dt>
                        <dd class="col-sm-8">@Model.Fertilizer.Id</dd>

                        <dt class="col-sm-4">Type</dt>
                        <dd class="col-sm-8">@Model.Fertilizer.Type</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            @Model.Fertilizer.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                    </dl>

                </div>
            </div>
        </div>

        <!-- 🌿 Plant -->
        <div class="col-md-6">
            <div class="card shadow-sm border-success h-100">
                <div class="card-header bg-success text-white fw-semibold">
                    Related Plant
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-sm-4">Id</dt>
                        <dd class="col-sm-8">@Model.Plant.Id</dd>

                        <dt class="col-sm-4">Mom Id</dt>
                        <dd class="col-sm-8">@Model.Plant.MomId</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Plant.Description</dd>

                        <dt class="col-sm-4">Active</dt>
                        <dd class="col-sm-8">
                            @(Model.Plant.IsActive ? "✅ Yes" : "❌ No")
                        </dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            @Model.Plant.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                    </dl>

                </div>
            </div>
        </div>

    </div>

    <!-- 🔘 Actions -->
    <div class="mt-4 d-flex gap-2">

        <a asp-action="Edit"
           asp-route-id="@Model.Fertilizer.Id"
           class="btn btn-success">
            ✏️ Edit
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to List
        </a>

    </div>

</div>