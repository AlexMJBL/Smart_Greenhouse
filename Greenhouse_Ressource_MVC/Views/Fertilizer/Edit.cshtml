@model Greenhouse_Ressource_MVC.Dtos.FertilizerWriteDto

@{
    ViewData["Title"] = "Edit Fertilizer";
}

<div class="container">

    <h2 class="mb-4 text-success">✏️ Edit Fertilizer</h2>

    <div class="card shadow-sm border-success">

        <div class="card-header bg-success text-white fw-semibold">
            Fertilizer Information
        </div>

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- 🌱 Type -->
                <div class="mb-3">
                    <label asp-for="Type" class="form-label fw-semibold"></label>
                    <input asp-for="Type" class="form-control" />
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <!-- 🌿 Plant -->
                <div class="mb-3">
                    <label asp-for="PlantId" class="form-label fw-semibold"></label>

                    <select asp-for="PlantId"
                            asp-items="ViewBag.Plants"
                            class="form-select">

                        <option value="">-- Select a plant --</option>

                    </select>

                    <span asp-validation-for="PlantId" class="text-danger"></span>
                </div>

                <!-- 🔘 Buttons -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-success">
                        💾 Save
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back to List
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}