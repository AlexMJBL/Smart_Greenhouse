@model Greenhouse_Ressource_MVC.Dtos.FertilizerWriteDto

@{
    ViewData["Title"] = "Create Fertilizer";
}

<div class="container">

    <h2 class="text-success mb-4">🌱 Add Fertilizer</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- TYPE -->
                <div class="mb-3">
                    <label asp-for="Type" class="form-label fw-semibold"></label>
                    <input asp-for="Type" class="form-control" placeholder="Ex: Liquid, Granular..." />
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>

                <!-- PLANT -->
                <div class="mb-3">
                    <label asp-for="PlantId" class="form-label fw-semibold"></label>
                    <select asp-for="PlantId"
                            asp-items="ViewBag.Plants"
                            class="form-select">

                        <option value="">🌿 Select a plant</option>
                    </select>
                    <span asp-validation-for="PlantId" class="text-danger"></span>
                </div>

                <!-- BUTTONS -->
                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        ✅ Create
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back to List
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}