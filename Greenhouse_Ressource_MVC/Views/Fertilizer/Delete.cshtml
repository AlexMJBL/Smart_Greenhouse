@model Greenhouse_Ressource_MVC.Dtos.FertilizerDto

@{
    ViewData["Title"] = "Delete Fertilizer";
}

<div class="container">

    <h2 class="text-danger mb-4">🗑️ Delete Fertilizer</h2>

    <div class="card shadow-sm border-danger">
        <div class="card-body">

            <h5 class="text-muted mb-3">
                Are you sure you want to delete this record?
            </h5>

            <dl class="row mb-4">

                <dt class="col-sm-3 fw-semibold">
                    @Html.DisplayNameFor(model => model.Id)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Id)
                </dd>

                <dt class="col-sm-3 fw-semibold">
                    @Html.DisplayNameFor(model => model.Type)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.Type)
                </dd>

                <dt class="col-sm-3 fw-semibold">
                    @Html.DisplayNameFor(model => model.PlantId)
                </dt>
                <dd class="col-sm-9">
                    @Html.DisplayFor(model => model.PlantId)
                </dd>

                <dt class="col-sm-3 fw-semibold">
                    @Html.DisplayNameFor(model => model.CreatedAt)
                </dt>
                <dd class="col-sm-9">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        ❌ Delete
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Cancel
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>