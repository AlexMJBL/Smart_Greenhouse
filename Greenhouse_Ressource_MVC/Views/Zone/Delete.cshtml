@model Greenhouse_Ressource_MVC.Dtos.ZoneDto

@{
    ViewData["Title"] = "Delete zone";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0 text-danger">⚠ Delete zone</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to list
        </a>
    </div>

    <!-- 🔹 CARD -->
    <div class="card shadow-sm border-danger">
        <div class="card-body">

            <h5 class="text-danger mb-3">
                Are you sure you want to delete this zone?
            </h5>

            <dl class="row mb-4">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Zone category</dt>
                <dd class="col-sm-9">@Model.ZoneCategoryId</dd>

                <dt class="col-sm-3">Created at</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

            </dl>

            <!-- 🔹 ACTIONS -->
            <form asp-action="DeleteConfirmed">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger">
                        🗑 Delete
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>