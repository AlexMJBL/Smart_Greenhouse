@model Greenhouse_Ressource_MVC.Dtos.ZoneWriteDto

@{
    ViewData["Title"] = "Edit zone";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">✏️ Edit zone</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to list
        </a>
    </div>

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card shadow-sm">

                <div class="card-header bg-dark text-white">
                    Zone information
                </div>

                <div class="card-body">

                    <form asp-action="Edit">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <!-- 🔹 DESCRIPTION -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label"></label>
                            <input asp-for="Description" class="form-control" />
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <!-- 🔹 CATEGORY -->
                        <div class="mb-4">
                            <label asp-for="ZoneCategoryId" class="form-label"></label>

                            <select asp-for="ZoneCategoryId"
                                    asp-items="ViewBag.SoilHumidityCategories"
                                    class="form-select">

                                <option value="">-- Select a category --</option>

                            </select>

                            <span asp-validation-for="ZoneCategoryId"
                                  class="text-danger"></span>
                        </div>

                        <!-- 🔹 ACTIONS -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                💾 Save
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}