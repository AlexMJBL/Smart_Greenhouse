@model Greenhouse_Ressource_MVC.Dtos.ZoneWriteDto

@{
    ViewData["Title"] = "Create zone";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">📍 Create zone</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to list
        </a>
    </div>

    <!-- 🔹 CARD -->
    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- Description -->
                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <input asp-for="Description" class="form-control" placeholder="Ex: Tropical zone" />
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <!-- Zone category -->
                <div class="mb-3">
                    <label asp-for="ZoneCategoryId" class="form-label fw-semibold"></label>

                    <select asp-for="ZoneCategoryId"
                            asp-items="ViewBag.SoilHumidityCategories"
                            class="form-select">

                        <option value="">-- Select a zone category --</option>

                    </select>

                    <span asp-validation-for="ZoneCategoryId" class="text-danger"></span>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-success">
                        ✅ Create zone
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}