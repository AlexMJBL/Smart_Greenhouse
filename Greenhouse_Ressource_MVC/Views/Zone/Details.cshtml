@model Greenhouse_Ressource_MVC.ViewModel.ZoneDetailViewModel

@{
    ViewData["Title"] = "Zone details";
}

<div class="dashboard-container">

    <!-- 🔹 HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">🌿 Zone details</h2>

        <div class="btn-group">
            <a asp-action="Edit" asp-route-id="@Model.Zone.Id"
               class="btn btn-outline-primary">
                ✏️ Edit
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                ⬅ Back to list
            </a>
        </div>
    </div>

    <div class="row">

        <!-- 🔹 ZONE CARD -->
        <div class="col-lg-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-dark text-white">
                    Zone
                </div>

                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-5">Id</dt>
                        <dd class="col-7">@Model.Zone.Id</dd>

                        <dt class="col-5">Description</dt>
                        <dd class="col-7">@Model.Zone.Description</dd>

                        <dt class="col-5">Created</dt>
                        <dd class="col-7">@Model.Zone.CreatedAt</dd>

                    </dl>

                </div>
            </div>
        </div>

        <!-- 🔹 CATEGORY CARD -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm h-100">

                <div class="card-header bg-info text-dark">
                    Zone category settings
                </div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6">

                            <h6 class="text-muted">Humidity (%)</h6>
                            <p>
                                <span class="badge bg-primary">
                                    @Model.ZoneCategory.HumidityMinPct
                                </span>
                                →
                                <span class="badge bg-primary">
                                    @Model.ZoneCategory.HumidityMaxPct
                                </span>
                            </p>

                            <h6 class="text-muted">Luminosity (lux)</h6>
                            <p>
                                <span class="badge bg-warning text-dark">
                                    @Model.ZoneCategory.LuminosityMinLux
                                </span>
                                →
                                <span class="badge bg-warning text-dark">
                                    @Model.ZoneCategory.LuminosityMaxLux
                                </span>
                            </p>

                            <h6 class="text-muted">Temperature (°C)</h6>
                            <p>
                                <span class="badge bg-danger">
                                    @Model.ZoneCategory.TemperatureMinC
                                </span>
                                →
                                <span class="badge bg-danger">
                                    @Model.ZoneCategory.TemperatureMaxC
                                </span>
                            </p>

                        </div>

                        <div class="col-md-6">

                            <h6 class="text-muted">Pressure (Pa)</h6>
                            <p>
                                <span class="badge bg-secondary">
                                    @Model.ZoneCategory.PressureMinPa
                                </span>
                                →
                                <span class="badge bg-secondary">
                                    @Model.ZoneCategory.PressureMaxPa
                                </span>
                            </p>

                            <h6 class="text-muted">Category name</h6>
                            <p class="fw-bold">
                                @Model.ZoneCategory.Name
                            </p>

                            <h6 class="text-muted">Created</h6>
                            <p>
                                @Model.ZoneCategory.CreatedAt
                            </p>

                        </div>

                    </div>

                </div>

            </div>
        </div>

    </div>

</div>