@model Greenhouse_Ressource_MVC.Dtos.SpecimenWriteDto

@{
    ViewData["Title"] = "Create specimen";
}

<div class="container mt-4">

    <h2 class="mb-4 text-success">🌿 Create specimen</h2>

    <div class="card shadow-sm border-success">

        <div class="card-header bg-success text-white fw-semibold">
            Specimen information
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- 🌱 NAME -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- 💧 SOIL HUMIDITY CATEGORY -->
                <div class="mb-3">
                    <label asp-for="SoilHumidityCatId" class="form-label fw-semibold"></label>

                    <select asp-for="SoilHumidityCatId"
                            asp-items="ViewBag.SoilHumidityCategories"
                            class="form-select">

                        <option value="">-- Select a soil humidity category --</option>

                    </select>

                    <span asp-validation-for="SoilHumidityCatId" class="text-danger"></span>
                </div>

                <!-- 🔘 BUTTONS -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-success">
                        💾 Create
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back to list
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}