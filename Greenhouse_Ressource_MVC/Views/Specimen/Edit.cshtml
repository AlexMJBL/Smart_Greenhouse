@model Greenhouse_Ressource_MVC.Dtos.SpecimenWriteDto

@{
    ViewData["Title"] = "Edit specimen";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🧬 Edit specimen</h2>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- NAME -->
                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold"></label>
                    <input asp-for="Name" class="form-control" placeholder="Enter specimen name" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <!-- SOIL HUMIDITY CATEGORY -->
                <div class="mb-3">
                    <label asp-for="SoilHumidityCatId" class="form-label fw-semibold"></label>

                    <select asp-for="SoilHumidityCatId"
                            asp-items="ViewBag.SoilHumidityCategories"
                            class="form-select">
                        <option value="">-- Select a soil humidity category --</option>
                    </select>

                    <span asp-validation-for="SoilHumidityCatId" class="text-danger"></span>
                </div>

                <!-- ACTIONS -->
                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-success shadow-sm">
                        💾 Save changes
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}