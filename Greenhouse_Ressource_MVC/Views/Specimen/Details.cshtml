@model Greenhouse_Ressource_MVC.ViewModel.SpecimenDetailViewModel

@{
    ViewData["Title"] = "Specimen details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>🧬 Specimen details</h2>

        <div>
            <a asp-action="Edit" asp-route-id="@Model.Specimen.Id"
               class="btn btn-warning shadow-sm">
                ✏️ Edit
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                ⬅ Back
            </a>
        </div>
    </div>

    <div class="row">

        <!-- SPECIMEN CARD -->
        <div class="col-md-6">

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-success text-white">
                    Specimen
                </div>

                <div class="card-body">

                    <h5 class="card-title">
                        @Model.Specimen.Name
                    </h5>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-4">Id</dt>
                        <dd class="col-sm-8">@Model.Specimen.Id</dd>

                        <dt class="col-sm-4">Created</dt>
                        <dd class="col-sm-8">
                            @Model.Specimen.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                    </dl>

                </div>
            </div>

        </div>


        <!-- SOIL HUMIDITY CATEGORY CARD -->
        <div class="col-md-6">

            <div class="card shadow-sm mb-4">

                <div class="card-header bg-info text-dark">
                    Soil humidity category
                </div>

                <div class="card-body">

                    <h5 class="card-title">
                        @Model.SoilHumidityCategory.Name
                    </h5>

                    <hr />

                    <dl class="row">

                        <dt class="col-sm-5">Id</dt>
                        <dd class="col-sm-7">
                            @Model.SoilHumidityCategory.Id
                        </dd>

                        <dt class="col-sm-5">Min humidity</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-primary">
                                @Model.SoilHumidityCategory.MinHumidityPct %
                            </span>
                        </dd>

                        <dt class="col-sm-5">Max humidity</dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-primary">
                                @Model.SoilHumidityCategory.MaxHumidityPct %
                            </span>
                        </dd>

                        <dt class="col-sm-5">Created</dt>
                        <dd class="col-sm-7">
                            @Model.SoilHumidityCategory.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                        </dd>

                    </dl>

                </div>

            </div>

        </div>

    </div>

</div>
