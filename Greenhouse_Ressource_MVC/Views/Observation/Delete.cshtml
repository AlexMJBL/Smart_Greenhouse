@model Greenhouse_Ressource_MVC.Dtos.ObservationDto

@{
    ViewData["Title"] = "Delete Observation";
}

<div class="container">

    <h2 class="mb-4 text-danger">🗑️ Delete Observation</h2>

    <div class="card shadow-sm border-danger">

        <div class="card-header bg-danger text-white fw-semibold">
            Are you sure you want to delete this?
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Plant</dt>
                <dd class="col-sm-9">@Model.PlantId</dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@Model.Rating</dd>

                <dt class="col-sm-3">Comments</dt>
                <dd class="col-sm-9">@Model.Comments</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.CreatedAt</dd>

            </dl>

            <!-- 🔘 Buttons -->
            <form asp-action="DeleteConfirmed" class="mt-4 d-flex gap-2">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    🗑️ Delete
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    ⬅ Back to List
                </a>

            </form>

        </div>
    </div>
</div>