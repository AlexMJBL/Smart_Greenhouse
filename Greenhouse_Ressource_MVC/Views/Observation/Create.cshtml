@model Greenhouse_Ressource_MVC.Dtos.ObservationWriteDto

@{
    ViewData["Title"] = "Create Observation";
}

<div class="container">

    <h2 class="mb-4 text-success">📝 New Observation</h2>

    <div class="card shadow-sm border-success">

        <div class="card-header bg-success text-white fw-semibold">
            Observation Information
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <!-- 🌿 Plant -->
                <div class="mb-3">
                    <label asp-for="PlantId" class="form-label fw-semibold"></label>

                    <select asp-for="PlantId"
                            asp-items="ViewBag.Plants"
                            class="form-select">

                        <option value="">-- Select a plant --</option>

                    </select>

                    <span asp-validation-for="PlantId" class="text-danger"></span>
                </div>

                <!-- ⭐ Rating -->
                <div class="mb-3">
                    <label asp-for="Rating" class="form-label fw-semibold"></label>

                    <select asp-for="Rating"
                            asp-items="ViewBag.Ratings"
                            class="form-select">

                        <option value="">-- Select a rating --</option>

                    </select>

                    <span asp-validation-for="Rating" class="text-danger"></span>
                </div>

                <!-- 💬 Comments -->
                <div class="mb-3">
                    <label asp-for="Comments" class="form-label fw-semibold"></label>
                    <textarea asp-for="Comments" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Comments" class="text-danger"></span>
                </div>

                <!-- 🔘 Buttons -->
                <div class="d-flex gap-2 mt-4">

                    <button type="submit" class="btn btn-success">
                        💾 Create
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        ⬅ Back to List
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}