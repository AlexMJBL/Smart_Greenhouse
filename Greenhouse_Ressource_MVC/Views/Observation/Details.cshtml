@model Greenhouse_Ressource_MVC.ViewModel.ObservationDetailViewModel;

@{
    ViewData["Title"] = "Observation Details";
}

<div class="container">

    <h2 class="mb-4 text-success">🔍 Observation Details</h2>

    <!-- 🌱 Observation -->
    <div class="card shadow-sm border-success mb-4">

        <div class="card-header bg-success text-white fw-semibold">
            Observation Information
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Observation.Id</dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@Model.Observation.Rating</dd>

                <dt class="col-sm-3">Comments</dt>
                <dd class="col-sm-9">@Model.Observation.Comments</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.Observation.CreatedAt</dd>

            </dl>

        </div>
    </div>

    <!-- 🌿 Plant -->
    <div class="card shadow-sm border-success mb-4">

        <div class="card-header bg-success text-white fw-semibold">
            Plant Information
        </div>

        <div class="card-body">

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Plant.Id</dd>

                <dt class="col-sm-3">Mom Id</dt>
                <dd class="col-sm-9">@Model.Plant.MomId</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Plant.Description</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @(Model.Plant.IsActive ? "✅ Yes" : "❌ No")
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9">@Model.Plant.CreatedAt</dd>

            </dl>

        </div>
    </div>

    <!-- 🔘 Buttons -->
    <div class="d-flex gap-2">

        <a asp-action="Edit" asp-route-id="@Model.Observation.Id"
           class="btn btn-success">
            ✏️ Edit
        </a>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ⬅ Back to List
        </a>

    </div>

</div>