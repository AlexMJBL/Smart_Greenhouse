@model IEnumerable<Greenhouse_Ressource_MVC.Dtos.ObservationDto>

@{
    ViewData["Title"] = "Observations";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-success mb-0">🌿 Observations</h2>

        <a asp-action="Create" class="btn btn-success">
            ➕ Create New
        </a>
    </div>

    <div class="card shadow-sm border-success">

        <div class="card-header bg-success text-white fw-semibold">
            Observation List
        </div>

        <div class="card-body p-0">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.PlantId)</th>
                        <th>@Html.DisplayNameFor(model => model.Rating)</th>
                        <th>@Html.DisplayNameFor(model => model.Comments)</th>
                        <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.PlantId</td>
                        <td>@item.Rating</td>
                        <td>@item.Comments</td>
                        <td>@item.CreatedAt</td>

                        <td class="text-end">

                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-success">
                                ✏️
                            </a>

                            <a asp-action="Details" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">
                                🔍
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">
                                🗑
                            </a>

                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>
    </div>

</div>