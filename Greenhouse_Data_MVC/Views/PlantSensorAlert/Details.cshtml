@model Greenhouse_Data_MVC.ViewModel.PlantSensorAlertViewModel

@{
    ViewData["Title"] = "Plant Sensor Alert Details";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="mb-4">🚨 Plant Sensor Alert Details</h3>

            <!-- ALERT INFO -->
            <h5 class="text-muted">Alert</h5>
            <dl class="row mb-4">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.PlantSensorAlert.Id</dd>

                <dt class="col-sm-3">Reason</dt>
                <dd class="col-sm-9 fw-semibold text-danger">
                    @Model.PlantSensorAlert.Reason
                </dd>

                <dt class="col-sm-3">Sensor Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">
                        @Model.PlantSensorAlert.SensorType
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.PlantSensorAlert.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <!-- PLANT INFO -->
            <h5 class="text-muted">Plant</h5>
            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Plant.Id</dd>

                <dt class="col-sm-3">Mom</dt>
                <dd class="col-sm-9">@Model.Plant.MomId</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Plant.Description</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.Plant.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Plant.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white border-0 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>
        </div>

    </div>

</div>