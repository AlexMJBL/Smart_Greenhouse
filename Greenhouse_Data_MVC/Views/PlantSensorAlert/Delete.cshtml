@model Greenhouse_Data_MVC.Dtos.PlantSensorAlertDto

@{
    ViewData["Title"] = "Delete Plant Sensor Alert";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="text-danger mb-3">⚠️ Delete Plant Sensor Alert</h3>
            <p class="text-muted">Are you sure you want to delete this?</p>

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Plant</dt>
                <dd class="col-sm-9">@Model.PlantId</dd>

                <dt class="col-sm-3">Reason</dt>
                <dd class="col-sm-9 fw-semibold text-danger">
                    @Model.Reason
                </dd>

                <dt class="col-sm-3">Sensor Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">
                        @Model.SensorType
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2">

            <form asp-action="DeleteConfirmed" class="m-0">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>