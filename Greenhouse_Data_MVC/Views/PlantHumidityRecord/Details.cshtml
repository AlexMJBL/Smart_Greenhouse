@model Greenhouse_Data_MVC.ViewModel.PlantHumidityRecordViewModel

@{
    ViewData["Title"] = "Plant Humidity Record Details";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h3 class="mb-3">💧 Plant Humidity Record</h3>

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.PlantHumidityRecord.Id</dd>

                <dt class="col-sm-3">Humidity</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">
                        @Model.PlantHumidityRecord.RecordPct%
                    </span>
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.PlantHumidityRecord.InRange)
                    {
                        <span class="badge bg-success">In Range</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Range</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.PlantHumidityRecord.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h3 class="mb-3">🌱 Plant</h3>

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Plant.Id</dd>

                <dt class="col-sm-3">Mom Id</dt>
                <dd class="col-sm-9">@Model.Plant.MomId</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Plant.Description</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.Plant.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Plant.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white border-0 text-end">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>
        </div>

    </div>

</div>