@model IEnumerable<Greenhouse_Data_MVC.Dtos.PlantHumidityRecordDto>

@{
    ViewData["Title"] = "Plant Humidity Records";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">💧 Plant Humidity Records</h2>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Id)</th>
                            <th>Humidity (%)</th>
                            <th>Status</th>
                            <th>@Html.DisplayNameFor(model => model.PlantId)</th>
                            <th>@Html.DisplayNameFor(model => model.CreatedAt)</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>

                                <td>
                                    <span class="fw-semibold">@item.RecordPct%</span>
                                </td>

                                <td>
                                    @if (item.InRange)
                                    {
                                        <span class="badge bg-success">In Range</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Range</span>
                                    }
                                </td>

                                <td>@item.PlantId</td>
                                <td>@item.CreatedAt</td>

                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Details
                                    </a>

                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>