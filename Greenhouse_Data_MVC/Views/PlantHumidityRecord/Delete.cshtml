@model Greenhouse_Data_MVC.Dtos.PlantHumidityRecordDto

@{
    ViewData["Title"] = "Delete Plant Humidity Record";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="text-danger mb-3">⚠️ Delete Plant Humidity Record</h3>
            <p class="text-muted">Are you sure you want to delete this record?</p>

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Humidity</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">
                        @Model.RecordPct%
                    </span>
                </dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.InRange)
                    {
                        <span class="badge bg-success">In Range</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Out of Range</span>
                    }
                </dd>

                <dt class="col-sm-3">Plant Id</dt>
                <dd class="col-sm-9">@Model.PlantId</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-between">

            <form asp-action="DeleteConfirmed" class="m-0">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>