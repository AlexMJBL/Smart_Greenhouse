@model Greenhouse_Data_MVC.Dtos.WateringDto

@{
    ViewData["Title"] = "Delete Watering";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="text-danger mb-3">⚠️ Delete Watering</h3>
            <p class="mb-4">Are you sure you want to delete this?</p>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Humidity Before</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-danger">
                        @Model.HumPctBefore%
                    </span>
                </dd>

                <dt class="col-sm-3">Humidity After</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-success">
                        @Model.HumPctAfter%
                    </span>
                </dd>

                <dt class="col-sm-3">Water Quantity</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">
                        @Model.WaterQuantityMl ml
                    </span>
                </dd>

                <dt class="col-sm-3">Plant</dt>
                <dd class="col-sm-9">@Model.PlantId</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed" class="mt-4">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">

                    <button type="submit" class="btn btn-danger">
                        Delete
                    </button>

                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Back to List
                    </a>

                </div>

            </form>

        </div>
    </div>

</div>