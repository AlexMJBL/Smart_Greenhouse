@model Greenhouse_Data_MVC.ViewModel.WateringViewModel

@{
    ViewData["Title"] = "Watering Details";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h3 class="mb-3">💧 Watering Details</h3>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Watering.Id</dd>

                <dt class="col-sm-3">Humidity Before</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-danger">
                        @Model.Watering.HumPctBefore%
                    </span>
                </dd>

                <dt class="col-sm-3">Humidity After</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-success">
                        @Model.Watering.HumPctAfter%
                    </span>
                </dd>

                <dt class="col-sm-3">Water Quantity</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">
                        @Model.Watering.WaterQuantityMl ml
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Watering.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>


    <div class="card shadow-sm border-0">
        <div class="card-body">

            <h4 class="mb-3">🌱 Plant</h4>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Plant.Id</dd>

                <dt class="col-sm-3">Mom Id</dt>
                <dd class="col-sm-9">@Model.Plant.MomId</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Plant.Description</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.Plant.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Plant.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>


    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

</div>