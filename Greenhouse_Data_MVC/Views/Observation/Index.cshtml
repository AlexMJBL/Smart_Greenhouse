@model IEnumerable<Greenhouse_Data_MVC.Dtos.ObservationDto>

@{
    ViewData["Title"] = "Observations";
}

<div class="page-header">
    <h1>🌿 Observations</h1>
</div>

<div class="table-card">

    <table class="table table-hover align-middle mb-0">

        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Plant</th>
                <th>Rating</th>
                <th>Comments</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.PlantId</td>
                    <td>
                        <span class="badge bg-success">@item.Rating</span>
                    </td>
                    <td>@item.Comments</td>
                    <td>@item.CreatedAt</td>
                    <td class="text-end">

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Details</a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>

                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>