@model Greenhouse_Data_MVC.ViewModel.ObservationViewModel

@{
    ViewData["Title"] = "Observation Details";
}

<div class="container mt-4">

    <!-- OBSERVATION -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h3 class="mb-4">👁️ Observation</h3>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Observation.Id</dd>

                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-primary">
                        @Model.Observation.Rating
                    </span>
                </dd>

                <dt class="col-sm-3">Comments</dt>
                <dd class="col-sm-9">@Model.Observation.Comments</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Observation.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>

    <!-- PLANT -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h3 class="mb-4">🌱 Plant</h3>

            <dl class="row">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Plant.Id</dd>

                <dt class="col-sm-3">MomId</dt>
                <dd class="col-sm-9">@Model.Plant.MomId</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Plant.Description</dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.Plant.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Plant.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>

    <!-- ACTION -->
    <div class="d-flex justify-content-end">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

</div>