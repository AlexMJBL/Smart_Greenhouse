@model Greenhouse_Data_MVC.Dtos.FertilizerDto

@{
    ViewData["Title"] = "Delete Fertilizer";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="text-danger mb-3">⚠️ Delete Fertilizer</h3>

            <p class="mb-4">
                Are you sure you want to delete this record?
            </p>

            <dl class="row mb-4">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-success-subtle text-success fw-semibold">
                        @Model.Type
                    </span>
                </dd>

                <dt class="col-sm-3">Plant</dt>
                <dd class="col-sm-9">@Model.PlantId</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed">

                <input type="hidden" asp-for="Id" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        Delete
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>