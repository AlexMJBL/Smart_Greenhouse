@model Greenhouse_Data_MVC.ViewModel.ZoneSensorAlertViewModel

@{
    ViewData["Title"] = "Details";
}

<div class="container mt-4">

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Zone Sensor Alert</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.ZoneSensorAlert.Id</dd>

                <dt class="col-sm-3">Reason</dt>
                <dd class="col-sm-9">@Model.ZoneSensorAlert.Reason</dd>

                <dt class="col-sm-3">Sensor Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-danger">
                        @Model.ZoneSensorAlert.SensorType
                    </span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">
                    @Model.ZoneSensorAlert.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Sensor</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Sensor.Id</dd>

                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9">@Model.Sensor.SensorCode</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Sensor.Description</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @Model.Sensor.Type
                    </span>
                </dd>

                <dt class="col-sm-3">Last Seen</dt>
                <dd class="col-sm-9">
                    @(Model.Sensor.LastSeen ? "Online" : "Offline")
                </dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.Sensor.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.Sensor.IsActive ? "Active" : "Inactive")
                    </span>
                </dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">
                    @Model.Sensor.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>
            </dl>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-success text-white">
            <h4 class="mb-0">Zone</h4>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Zone.Id</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Zone.Description</dd>

                <dt class="col-sm-3">Created At</dt>
                <dd class="col-sm-9">
                    @Model.Zone.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>
            </dl>
        </div>
    </div>

    <div class="text-end">
        <a asp-action="Index" class="btn btn-outline-secondary">
            Back to List
        </a>
    </div>

</div>
