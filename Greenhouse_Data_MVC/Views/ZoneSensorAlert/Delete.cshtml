@model Greenhouse_Data_MVC.Dtos.ZoneSensorAlertDto

@{
    ViewData["Title"] = "Delete Zone Sensor Alert";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="text-danger mb-3">🗑️ Delete Zone Sensor Alert</h3>
            <p class="text-muted">Are you sure you want to delete this alert?</p>

            <hr />

            <dl class="row mb-4">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Sensor</dt>
                <dd class="col-sm-9">@Model.SensorId</dd>

                <dt class="col-sm-3">Reason</dt>
                <dd class="col-sm-9">@Model.Reason</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-warning text-dark">
                        @Model.SensorType
                    </span>
                </dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <form asp-action="DeleteConfirmed" class="d-flex justify-content-end gap-2">

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

            </form>

        </div>

    </div>

</div>
