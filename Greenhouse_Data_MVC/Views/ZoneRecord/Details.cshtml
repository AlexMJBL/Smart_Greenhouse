@model Greenhouse_Data_MVC.ViewModel.ZoneRecordViewModel

@{
    ViewData["Title"] = "Zone Record Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">📊 Zone Record Details</h2>
    </div>

    <!-- Zone Record -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">Zone Record</h5>

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.ZoneRecord.Id</dd>

                <dt class="col-sm-3">Value</dt>
                <dd class="col-sm-9 fw-semibold">@Model.ZoneRecord.Record</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.ZoneRecord.InRange)
                    {
                        <span class="badge bg-success">✅ OK</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">❌ Alert</span>
                    }
                </dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">@Model.ZoneRecord.Type</span>
                </dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.ZoneRecord.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>

    <!-- Zone -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <h5 class="card-title mb-3">Zone</h5>

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Zone.Id</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Zone.Description</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Zone.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>
    </div>

    <div class="text-end">
        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Back to List
        </a>
    </div>

</div>
