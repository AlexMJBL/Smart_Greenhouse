@model Greenhouse_Data_MVC.Dtos.ZoneRecordDto

@{
    ViewData["Title"] = "Delete Zone Record";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="text-danger mb-3">⚠️ Delete Zone Record</h3>
            <p class="text-muted">Are you sure you want to delete this record?</p>

            <hr />

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Id</dd>

                <dt class="col-sm-3">Value</dt>
                <dd class="col-sm-9 fw-bold">@Model.Record</dd>

                <dt class="col-sm-3">Status</dt>
                <dd class="col-sm-9">
                    @if (Model.InRange)
                    {
                        <span class="badge bg-success">OK</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Alert</span>
                    }
                </dd>

                <dt class="col-sm-3">Zone</dt>
                <dd class="col-sm-9">@Model.ZoneId</dd>

                <dt class="col-sm-3">Sensor</dt>
                <dd class="col-sm-9">@Model.SensorId</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">@Model.Type</span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-end gap-2">

            <form asp-action="DeleteConfirmed">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    Delete
                </button>
            </form>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>

        </div>

    </div>

</div>
