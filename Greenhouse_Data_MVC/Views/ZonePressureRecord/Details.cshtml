@model Greenhouse_Data_MVC.ViewModel.ZonePressureRecordViewModel

@{
    ViewData["Title"] = "Zone Pressure Record Details";
}

<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="mb-4">📊 Zone Pressure Record Details</h3>

            <!-- PRESSURE RECORD -->
            <h5 class="text-primary">Pressure Record</h5>
            <hr />

            <dl class="row mb-4">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.ZonePressureRecord.Id</dd>

                <dt class="col-sm-3">Pressure</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-info text-dark">
                        @Model.ZonePressureRecord.RecordedHPa hPa
                    </span>
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.ZonePressureRecord.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <!-- ZONE -->
            <h5 class="text-success">Zone</h5>
            <hr />

            <dl class="row mb-4">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Zone.Id</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Zone.Description</dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Zone.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

            <!-- SENSOR -->
            <h5 class="text-warning">Sensor</h5>
            <hr />

            <dl class="row mb-0">

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9">@Model.Sensor.Id</dd>

                <dt class="col-sm-3">Code</dt>
                <dd class="col-sm-9">@Model.Sensor.SensorCode</dd>

                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Sensor.Description</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">
                    <span class="badge bg-secondary">
                        @Model.Sensor.Type
                    </span>
                </dd>

                <dt class="col-sm-3">Last Seen</dt>
                <dd class="col-sm-9">
                    @if (Model.Sensor.LastSeen)
                    {
                        <span class="badge bg-info text-dark">Online</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Offline</span>
                    }
                </dd>

                <dt class="col-sm-3">Active</dt>
                <dd class="col-sm-9">
                    @if (Model.Sensor.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </dd>

                <dt class="col-sm-3">Created</dt>
                <dd class="col-sm-9 text-muted">
                    @Model.Sensor.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                </dd>

            </dl>

        </div>

        <div class="card-footer bg-white border-0 d-flex justify-content-end">

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

        </div>

    </div>

</div>